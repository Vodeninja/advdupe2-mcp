{
  "mcpServers": {
    "adv2mcp": {
      "command": "C:/path/to/adv2mcp/.venv/Scripts/python.exe",
      "args": ["-m", "adv2mcp"],
      "env": {
        "ADV2MCP_DUPE_DIR": "C:/path/to/GarrysMod/garrysmod/data/advdupe2",
